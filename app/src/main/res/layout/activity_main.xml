<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="60dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== YELLOW HEADER ===== -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:background="#FFC107"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/llHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/ivTruckHeader"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Orders"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="View your completed trips here. You can\ndownload invoices or quickly book the\nsame order again."
                        android:textSize="12sp"
                        android:textColor="#333333"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivTruckHeader"
                    android:layout_width="140dp"
                    android:layout_height="104dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleType="fitEnd"
                    android:src="@drawable/imagelogo" />
            </RelativeLayout>

            <!-- ===== WHITE SEARCH + FILTER + SORT ROW ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical">

                <!-- Search Bar -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/bg_search_bar">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="#AAAAAA"/>

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:hint="Search by Order ID / Location"
                        android:textSize="12sp"
                        android:textColorHint="#AAAAAA"
                        android:background="@null"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:singleLine="true"/>
                </LinearLayout>

                <!-- Filter Button with icon -->
                <LinearLayout
                    android:id="@+id/btnFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_filter_sort_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_filter"
                        app:tint="#333333"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Filter"
                        android:textSize="13sp"
                        android:textColor="#333333"/>
                </LinearLayout>

                <!-- Sort Button with icon -->
                <LinearLayout
                    android:id="@+id/btnSort"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_filter_sort_btn"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_sort"
                        app:tint="#333333"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Sort"
                        android:textSize="13sp"
                        android:textColor="#333333"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== TABS inside a WHITE CARD ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="25dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/llTabs"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tabAll"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="All Orders"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="#000000"
                            android:background="@drawable/bg_tab_selected"
                            android:gravity="center"
                            android:paddingHorizontal="18dp"/>

                        <TextView
                            android:id="@+id/tabCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Completed"
                            android:textSize="13sp"
                            android:textColor="#555555"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"/>

                        <TextView
                            android:id="@+id/tabCancelled"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Cancelled"
                            android:textSize="13sp"
                            android:textColor="#555555"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"/>

                        <TextView
                            android:id="@+id/tabBookedAgain"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="Booked Again"
                            android:textSize="13sp"
                            android:textColor="#555555"
                            android:gravity="center"
                            android:paddingHorizontal="16dp"/>

                    </LinearLayout>
                </HorizontalScrollView>
            </androidx.cardview.widget.CardView>

            <!-- ===== INFO BANNER ===== -->
            <LinearLayout
                android:id="@+id/llInfoBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#EEF2FF"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:layout_marginTop="10px"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_info"
                    app:tint="#5C6BC0"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="यहाँ आपके सभी पिछले ऑर्डर दिखाए गए हैं।"
                        android:textSize="12sp"
                        android:textColor="#333333"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="आप इनवॉइस डाउनलोड कर सकते हैं या उसी पते पर दोबारा ऑर्डर कर सकते हैं।"
                        android:textSize="12sp"
                        android:textColor="#333333"/>
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivCloseBanner"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_close"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="#888888"/>
            </LinearLayout>

            <!-- ===== ORDERS RecyclerView ===== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="80dp"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== HELP FAB (Yellow circle, bottom-right above bottom nav) ===== -->
    <LinearLayout
        android:id="@+id/fabHelp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="76dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_help_fab"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_headset"
            app:tint="#000000"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Help"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#000000"/>
    </LinearLayout>

    <!-- ===== BOTTOM NAVIGATION ===== -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <!-- Home -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="#9E9E9E"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textSize="10sp"
                android:textColor="#9E9E9E"/>
        </LinearLayout>

        <!-- Orders (SELECTED — yellow) -->
        <LinearLayout
            android:id="@+id/navOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_orders"
                app:tint="#FFC107"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Orders"
                android:textSize="10sp"
                android:textColor="#FFC107"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Payments -->
        <LinearLayout
            android:id="@+id/navPayments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_payments"
                app:tint="#9E9E9E"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Payments"
                android:textSize="10sp"
                android:textColor="#9E9E9E"/>
        </LinearLayout>

        <!-- Account -->
        <LinearLayout
            android:id="@+id/navAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_account"
                app:tint="#9E9E9E"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Account"
                android:textSize="10sp"
                android:textColor="#9E9E9E"/>
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>